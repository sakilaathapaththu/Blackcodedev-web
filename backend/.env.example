# Copy to .env for local development. Never commit the real .env file.
NODE_ENV=development
PORT=4000

# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# Long random string (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_API_KEY=

# Frontend origins allowed to call the API (comma separated). Required in production.
CORS_ORIGINS=http://localhost:3000,https://blackcodedev.com,https://www.blackcodedev.com

# Vercel Blob (CV uploads). BLOB_ACCESS=private needs a private Blob store.
BLOB_READ_WRITE_TOKEN=
BLOB_ACCESS=public

# Contact form email (Gmail + App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_TO_EMAIL=helloblackcodedev@gmail.com
